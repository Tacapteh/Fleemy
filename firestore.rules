rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Règles pour les collections utilisateur
    match /users/{uid}/{collection}/{document} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    
    // Règles pour les collections d'équipe
    match /teams/{teamId}/{collection}/{document} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                    request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if request.auth != null && 
                            resource.data.owner_id == request.auth.uid;
    }
    
    // Règles par défaut - interdire tout accès non spécifié
    match /{document=**} {
      allow read, write: if false;
    }
  }
}