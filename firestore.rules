rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers (sans 'let' ni 'if' blocs) ----
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Normalise une string non vide
    function normId(v) {
      return (v is string && v.size() > 0) ? v : null;
    }

    // Owner détecté à partir du payload ou du doc, sinon defaultUid
    function planningOwnerFromData(defaultUid) {
      return normId(request.resource != null ? request.resource.data.owner_uid : null) != null
        ? normId(request.resource.data.owner_uid)
        : (
            normId(request.resource != null ? request.resource.data.user_id : null) != null
            ? normId(request.resource.data.user_id)
            : (
                normId(resource != null ? resource.data.owner_uid : null) != null
                ? normId(resource.data.owner_uid)
                : (
                    normId(resource != null ? resource.data.user_id : null) != null
                    ? normId(resource.data.user_id)
                    : defaultUid
                  )
              )
          );
    }

    // TeamId détecté à partir du payload ou du doc, sinon defaultTeamId
    function planningTeamFromData(defaultTeamId) {
      return normId(request.resource != null ? request.resource.data.team_id : null) != null
        ? normId(request.resource.data.team_id)
        : (
            normId(resource != null ? resource.data.team_id : null) != null
            ? normId(resource.data.team_id)
            : defaultTeamId
          );
    }

    function matchesPlanningOwner(expectedOwner) {
      return planningOwnerFromData(expectedOwner) == expectedOwner;
    }

    function matchesPlanningTeam(expectedTeamId) {
      return (expectedTeamId == null)
        ? (planningTeamFromData(null) == null)
        : (planningTeamFromData(expectedTeamId) == expectedTeamId);
    }

    // Vérifie appartenance/ownership équipe (formats 'members' list OU map, + fallbacks)
    function isTeamMember(teamId) {
      return isAuthenticated() && (
        (
          get(/databases/$(database)/documents/teams/$(teamId)).exists()
          &&
          (
            (
              (get(/databases/$(database)/documents/teams/$(teamId)).data.members is list)
              &&
              (request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members)
            )
            ||
            (
              (get(/databases/$(database)/documents/teams/$(teamId)).data.members is map)
              &&
              (request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members)
            )
            ||
            (get(/databases/$(database)/documents/teams/$(teamId)).data.owner_uid == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid)
          )
        )
        ||
        exists(/databases/$(database)/documents/teams/$(teamId)/memberships/$(request.auth.uid))
        ||
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
      );
    }

    function canWritePlanningFor(ownerUid) {
      return isAuthenticated() && request.auth.uid == ownerUid;
    }

    function canReadPlanningFor(ownerUid, expectedTeamId) {
      return isAuthenticated() && (
        request.auth.uid == ownerUid
        ||
        (
          planningTeamFromData(expectedTeamId) is string
          && planningTeamFromData(expectedTeamId).size() > 0
          && isTeamMember(planningTeamFromData(expectedTeamId))
        )
      );
    }

    // ---- Espace /users/{uid} ----
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /planningEvents/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /weeklyTasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ---- Clients (scopés par user_id) ----
    match /clients/{clientId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;

      match /{document=**} {
        allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
        allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
        allow update: if isAuthenticated()
          && resource.data.user_id == request.auth.uid
          && request.resource.data.user_id == request.auth.uid;
        allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      }
    }

    // ---- Teams ----
    match /teams/{teamId} {
      allow read: if isTeamMember(teamId);
      allow write: if isTeamMember(teamId)
        || (isAuthenticated() && get(/databases/$(database)/documents/teams/$(teamId)).data.owner_uid == request.auth.uid);

      match /memberships/{uid} {
        allow read: if isTeamMember(teamId) || (isAuthenticated() && request.auth.uid == uid);
        allow write: if isAuthenticated() && request.auth.uid == uid;
      }

      match /teamPlanning/{docId} {
        allow read: if request.auth != null
          && (request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members);
        allow write: if false; // écriture uniquement via backend
      }

      match /members/{memberUid} {
        allow read: if isTeamMember(teamId) || (isAuthenticated() && request.auth.uid == memberUid);
        allow write: if isAuthenticated() && request.auth.uid == memberUid;

        match /planningEvents/{eventId} {
          allow read, write: if isAuthenticated() && request.auth.uid == memberUid;
        }

        match /weeklyTasks/{taskId} {
          allow read, write: if isAuthenticated() && request.auth.uid == memberUid;
        }

        match /{document=**} {
          allow read: if isTeamMember(teamId) || (isAuthenticated() && request.auth.uid == memberUid);
          allow write: if isAuthenticated() && request.auth.uid == memberUid;
        }
      }
    }

    // ---- dailyTodos (on s’appuie sur user_id + teamId) ----
    match /dailyTodos/{docId} {
      // Lecture : propriétaire OU membre d’équipe si teamId présent
      allow read: if isAuthenticated() && (
        (resource != null && resource.data.user_id == request.auth.uid)
        ||
        (
          resource != null
          && resource.data.teamId is string
          && resource.data.teamId.size() > 0
          && isTeamMember(resource.data.teamId)
        )
      );

      // Écriture : uniquement le propriétaire (user_id dans le payload)
      allow write: if isAuthenticated()
        && request.resource != null
        && request.resource.data.user_id == request.auth.uid;
    }

  }
}
