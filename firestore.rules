rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /planningEvents/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /weeklyTasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isTeamMember(teamId) {
      if (request.auth == null) {
        return false;
      }

      let teamPath = /databases/$(database)/documents/teams/$(teamId);
      let teamDoc = get(teamPath);
      if (!teamDoc.exists()) {
        return false;
      }

      // Accept direct members list from the team document when present.
      if (teamDoc.data.members is list &&
          teamDoc.data.members.hasAny([request.auth.uid])) {
        return true;
      }

      // Support historical team documents storing the members in a map
      // (``{ uid: true }`` or ``{ uid: { active: true } }``).
      if (teamDoc.data.members is map) {
        if (teamDoc.data.members.keys().hasAny([request.auth.uid])) {
          return true;
        }

        let memberEntry = teamDoc.data.members[request.auth.uid];
        if (memberEntry is map) {
          if (memberEntry.active == true) {
            return true;
          }
          if (memberEntry.uid == request.auth.uid) {
            return true;
          }
        }
      }

      // Allow team owners stored with either camelCase or snake_case keys.
      if (teamDoc.data.owner_uid == request.auth.uid ||
          teamDoc.data.ownerUid == request.auth.uid) {
        return true;
      }

      // Fallback to dedicated membership/member documents used by the backend.
      let membershipDoc = get(
        /databases/$(database)/documents/teams/$(teamId)/memberships/$(request.auth.uid)
      );
      if (membershipDoc.exists()) {
        return true;
      }

      let memberDoc = get(
        /databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)
      );
      return memberDoc.exists();
    }

    function normalizeIdentifier(value) {
      return value is string && value.size() > 0 ? value : null;
    }

    function planningOwnerFromData(defaultUid) {
      let owner = null;
      if (request.resource != null) {
        owner = normalizeIdentifier(request.resource.data.owner_uid);
        if (owner == null) {
          owner = normalizeIdentifier(request.resource.data.user_id);
        }
      }
      if (owner == null && resource != null) {
        owner = normalizeIdentifier(resource.data.owner_uid);
        if (owner == null) {
          owner = normalizeIdentifier(resource.data.user_id);
        }
      }
      return owner != null ? owner : defaultUid;
    }

    function planningTeamFromData(defaultTeamId) {
      let teamId = null;
      if (request.resource != null) {
        teamId = normalizeIdentifier(request.resource.data.team_id);
      }
      if (teamId == null && resource != null) {
        teamId = normalizeIdentifier(resource.data.team_id);
      }
      return teamId != null ? teamId : defaultTeamId;
    }

    function matchesPlanningOwner(expectedOwner) {
      return planningOwnerFromData(expectedOwner) == expectedOwner;
    }

    function matchesPlanningTeam(expectedTeamId) {
      let teamId = planningTeamFromData(expectedTeamId);
      if (expectedTeamId == null) {
        return teamId == null;
      }
      return teamId == expectedTeamId;
    }

    function canWritePlanningFor(ownerUid) {
      return isAuthenticated() && request.auth.uid == ownerUid;
    }

    function canReadPlanningFor(ownerUid, expectedTeamId) {
      if (!isAuthenticated()) {
        return false;
      }
      if (request.auth.uid == ownerUid) {
        return true;
      }
      let teamId = planningTeamFromData(expectedTeamId);
      return teamId is string && teamId.size() > 0 && isTeamMember(teamId);
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if
        isAuthenticated() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;

      match /{document=**} {
        allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
        allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
        allow update: if
          isAuthenticated() &&
          resource.data.user_id == request.auth.uid &&
          request.resource.data.user_id == request.auth.uid;
        allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      }
    }

    match /teams/{teamId} {
      allow read: if isTeamMember(teamId);

      match /memberships/{uid} {
        allow read: if isTeamMember(teamId) || (isAuthenticated() && request.auth.uid == uid);
        allow write: if isAuthenticated() && request.auth.uid == uid;
      }

      match /teamPlanning/{itemId} {
        allow read, write: if isTeamMember(teamId);
      }

      match /members/{memberUid} {
        allow read: if isTeamMember(teamId) || (isAuthenticated() && request.auth.uid == memberUid);
        allow write: if isAuthenticated() && request.auth.uid == memberUid;

        match /planningEvents/{eventId} {
          allow read, write: if isAuthenticated() && request.auth.uid == memberUid;
        }

        match /weeklyTasks/{taskId} {
          allow read, write: if isAuthenticated() && request.auth.uid == memberUid;
        }

        match /{document=**} {
          allow read: if isTeamMember(teamId) || (isAuthenticated() && request.auth.uid == memberUid);
          allow write: if isAuthenticated() && request.auth.uid == memberUid;
        }
      }
    }

    match /dailyTodos/{docId} {
      function extractUserId() {
        return docId.split('_')[0];
      }

      function isOwner() {
        return isAuthenticated() && request.auth.uid == extractUserId();
      }

      function canReadTodo() {
        if (!isAuthenticated()) {
          return false;
        }
        let ownerId = extractUserId();
        if (request.auth.uid == ownerId) {
          return true;
        }
        let teamDoc = exists(/databases/$(database)/documents/teams/$(resource.data.teamId)) 
          ? get(/databases/$(database)/documents/teams/$(resource.data.teamId)) 
          : null;
        return teamDoc != null && (
          (teamDoc.data.members is list && teamDoc.data.members.hasAny([request.auth.uid])) ||
          teamDoc.data.owner_uid == request.auth.uid
        );
      }

      allow read: if canReadTodo();
      allow write: if isOwner();
    }
  }
}
