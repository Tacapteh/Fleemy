# Frontend
REACT_APP_API_URL=http://localhost:8000

# Backend
FIREBASE_CREDENTIALS=./backend/serviceAccountKey.json
# If you don't have a service account JSON file, set GOOGLE_APPLICATION_CREDENTIALS
# to its path or leave both empty and provide FIREBASE_PROJECT_ID so tokens can
# be verified (data will only be stored in memory)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
CORS_ALLOW_ORIGINS=https://fleemy.web.app,http://localhost:5173
