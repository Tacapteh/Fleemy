# Frontend
REACT_APP_API_URL=http://localhost:8000

# Backend
FIREBASE_CREDENTIALS=./backend/serviceAccountKey.json
# If you don't have a service account JSON file, leave FIREBASE_CREDENTIALS empty
# and set FIREBASE_PROJECT_ID to your Firebase project id so tokens can be
# verified (data will only be stored in memory)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
CORS_ALLOW_ORIGINS=http://localhost:3000
